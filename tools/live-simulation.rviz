Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    - /Camera point clouds1
    - /Segmentation masks1
    Splitter Ratio: 0.48
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
  SyncMode: 0
  SyncSource: ''
Visualization Manager:
  Class: ''
  Name: root
  Enabled: true
  Global Options:
    Fixed Frame: world
    Background Color: 32; 36; 43
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Warehouse floor grid
    Enabled: true
    Cell Size: 0.25
    Plane Cell Count: 20
    Color: 88; 96; 106
    Alpha: 0.35
    Plane: XY
    Reference Frame: world
    Line Style:
      Value: Lines
      Line Width: 0.01
  - Class: rviz_default_plugins/RobotModel
    Name: TIAGo Pro
    Enabled: true
    Alpha: 1.0
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Visual Enabled: true
    Collision Enabled: false
    Update Interval: 0.0
  - Class: rviz_common/Group
    Name: Camera point clouds
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Head cloud
      Enabled: true
      Topic:
        Value: /head_front_camera/depth/color/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Alpha: 0.65
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Style: Points
      Size (Pixels): 2
      Size (m): 0.003
      Decay Time: 0.0
      Selectable: true
      Use Fixed Frame: true
      Color: 30; 205; 240
    - Class: rviz_default_plugins/PointCloud2
      Name: Left wrist cloud
      Enabled: true
      Topic:
        Value: /tote_sensors/left/depth/color/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Alpha: 0.65
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Style: Points
      Size (Pixels): 2
      Size (m): 0.003
      Decay Time: 0.0
      Selectable: true
      Use Fixed Frame: true
      Color: 255; 180; 45
    - Class: rviz_default_plugins/PointCloud2
      Name: Right wrist cloud
      Enabled: true
      Topic:
        Value: /tote_sensors/right/depth/color/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Alpha: 0.65
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Style: Points
      Size (Pixels): 2
      Size (m): 0.003
      Decay Time: 0.0
      Selectable: true
      Use Fixed Frame: true
      Color: 235; 100; 195
  - Class: rviz_common/Group
    Name: Segmentation masks
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Image
      Name: Head mask
      Enabled: true
      Topic:
        Value: /tote_segmentation/head/mask
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Normalize Range: false
      Min Value: 0.0
      Max Value: 255.0
      Median window: 5
    - Class: rviz_default_plugins/Image
      Name: Left wrist mask
      Enabled: true
      Topic:
        Value: /tote_segmentation/left/mask
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Normalize Range: false
      Min Value: 0.0
      Max Value: 255.0
      Median window: 5
    - Class: rviz_default_plugins/Image
      Name: Right wrist mask
      Enabled: true
      Topic:
        Value: /tote_segmentation/right/mask
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Transport Hint: raw
      Normalize Range: false
      Min Value: 0.0
      Max Value: 255.0
      Median window: 5
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Robot and tote
      Distance: 3.1
      Pitch: 0.48
      Yaw: 0.8
      Focal Point:
        X: 0.5
        Y: 0.0
        Z: 0.65
      Target Frame: world
      Near Clip Distance: 0.01
    Saved: null
Window Geometry:
  Width: 1600
  Height: 1000
  X: 20
  Y: 20
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Time:
    collapsed: false
  Head RGB:
    collapsed: false
  Head mask:
    collapsed: false
  Head depth Z (m):
    collapsed: false
  Head calibrated view:
    collapsed: false
  Left wrist RGB:
    collapsed: false
  Left wrist mask:
    collapsed: false
  Left wrist depth Z (m):
    collapsed: false
  Left wrist calibrated view:
    collapsed: false
  Right wrist RGB:
    collapsed: false
  Right wrist mask:
    collapsed: false
  Right wrist depth Z (m):
    collapsed: false
  Right wrist calibrated view:
    collapsed: false
